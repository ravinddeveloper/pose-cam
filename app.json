{
  "expo": {
    "name": "PoseGenius AI",
    "slug": "posegenius-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "posegenius",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.posegenius.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow PoseGenius AI to access your camera to provide live pose guidance and capture photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.posegenius.ai",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PoseGenius AI to access your camera to provide live pose guidance and capture photos."
        }
      ]
    ]
  }
}
