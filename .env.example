# ====================================================================
# PoseGenius AI - Environment Configuration Example
# ====================================================================
# All features work out of the box in 100% OFFLINE & FREE mode.
# No variables in this file are required for standard operation.
# ====================================================================

# Optional: Default AI Provider Mode ('local' or 'online')
EXPO_PUBLIC_AI_MODE=local

# Optional: Custom Self-Hosted / Free AI Endpoint
# Examples:
#   Local Ollama (Android Emulator): http://10.0.2.2:11434/v1/chat/completions
#   Local Ollama (Physical Device):  http://192.168.1.100:11434/v1/chat/completions
#   Groq Free Developer Tier:        https://api.groq.com/openai/v1/chat/completions
#   OpenRouter Free Models:          https://openrouter.ai/api/v1/chat/completions
EXPO_PUBLIC_CUSTOM_AI_ENDPOINT=

# Optional: API Key for configured online endpoint (NEVER committed to git)
EXPO_PUBLIC_CUSTOM_AI_KEY=

# Optional: Default Model Name
EXPO_PUBLIC_CUSTOM_AI_MODEL=mistralai/mistral-7b-instruct:free

# Optional: Openverse Public API Rate-Limit Token (optional registered client ID)
EXPO_PUBLIC_OPENVERSE_CLIENT_ID=
